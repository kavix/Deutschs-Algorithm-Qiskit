   "source": [
    "def daut_oracle(qc,f_type):\n",
    "    if f_type == 1:\n",
    "        pass\n",
    "    elif f_type == 2:\n",
    "        qc.x(1)\n",
    "    elif f_type == 3:\n",
    "        qc.cx(0,1)\n",
    "    elif f_type == 4:\n",
    "        qc.x(0)\n",
    "        qc.cx(0,1)\n",
    "        "
